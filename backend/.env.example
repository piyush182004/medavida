# Copy to .env and fill in. Never commit .env.

# PostgreSQL (recommended). Local Docker:
#   docker run -d --name slotzero-pg -e POSTGRES_USER=slotzero -e POSTGRES_PASSWORD=slotzero \
#     -e POSTGRES_DB=slotzero -p 5432:5432 postgres:16-alpine
DATABASE_URL=postgresql://slotzero:slotzero@localhost:5432/slotzero

SECRET_KEY=change-me-to-a-long-random-string
CORS_ORIGINS=*
SEED_DEMO=true

# AI document & note summaries (any OpenAI-compatible API; OpenRouter by default)
OPENROUTER_API_KEY=
AI_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free
# AI_BASE_URL=https://openrouter.ai/api/v1
